{
  "type": "object",
  "properties": {
    "identity": {
      "$ref": "https://agent.example.invalid/contracts/identity.schema.json"
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "toolVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "resource": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{1,63}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "policyDecisionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "approvalId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    }
  },
  "required": [
    "identity",
    "toolId",
    "toolVersion",
    "resource",
    "scopes",
    "policyDecisionId",
    "invocationId"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/credential-request.schema.json",
  "title": "credential-request"
}
