{
  "type": "object",
  "properties": {
    "credentialRef": {
      "type": "string",
      "pattern": "^lease-[a-f0-9]{32}$"
    },
    "audience": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{1,63}$"
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "nonExportable": {
      "const": true
    }
  },
  "required": [
    "credentialRef",
    "audience",
    "scopes",
    "expiresAt",
    "nonExportable"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/credential-lease.schema.json",
  "title": "credential-lease"
}
