{
  "type": "object",
  "properties": {
    "parentInvocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "invocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "callerAgentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "targetAgentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "targetAgentVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "identity": {
      "$ref": "https://agent.example.invalid/contracts/identity.schema.json"
    },
    "policy": {
      "$ref": "https://agent.example.invalid/contracts/policy.schema.json"
    },
    "request": {
      "$ref": "https://agent.example.invalid/contracts/invocation.schema.json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "visitedAgents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9.-]{1,63}$"
      },
      "uniqueItems": true
    },
    "depth": {
      "type": "integer",
      "minimum": 1
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 1
    },
    "budgetRemaining": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "parentInvocationId",
    "invocationId",
    "callerAgentId",
    "targetAgentId",
    "targetAgentVersion",
    "identity",
    "policy",
    "request",
    "traceparent",
    "visitedAgents",
    "depth",
    "maxDepth",
    "budgetRemaining"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/cross-agent.schema.json",
  "title": "cross-agent"
}
