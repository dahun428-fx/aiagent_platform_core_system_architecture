{
  "type": "object",
  "properties": {
    "invocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "toolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "status": {
      "enum": [
        "succeeded",
        "unknown_outcome"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "content"
      ],
      "additionalProperties": false
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
    }
  },
  "required": [
    "invocationId",
    "toolId",
    "status",
    "output",
    "traceparent"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/tool-result.schema.json",
  "title": "tool-result"
}
