{
  "type": "object",
  "properties": {
    "capability": {
      "enum": [
        "chat",
        "embedding"
      ]
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "identity": {
      "$ref": "https://agent.example.invalid/contracts/identity.schema.json"
    },
    "policy": {
      "$ref": "https://agent.example.invalid/contracts/policy.schema.json"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
    }
  },
  "required": [
    "capability",
    "messages",
    "identity",
    "policy",
    "traceparent"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/model-request.schema.json",
  "title": "model-request"
}
