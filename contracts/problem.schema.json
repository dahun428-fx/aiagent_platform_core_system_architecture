{
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "format": "uri"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string",
      "minLength": 1
    },
    "instance": {
      "type": "string",
      "minLength": 1
    },
    "code": {
      "enum": [
        "UNAUTHENTICATED",
        "FORBIDDEN",
        "VALIDATION_ERROR",
        "NOT_FOUND",
        "CONFLICT",
        "NOT_IMPLEMENTED",
        "UPSTREAM_UNAVAILABLE"
      ]
    },
    "traceId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$"
    }
  },
  "required": [
    "type",
    "title",
    "status",
    "code",
    "traceId"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/problem.schema.json",
  "title": "problem"
}
