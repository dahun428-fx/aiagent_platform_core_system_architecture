{
  "type": "object",
  "properties": {
    "invocationId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "state": {
      "enum": [
        "accepted",
        "running",
        "waiting_approval",
        "cancel_requested",
        "cancelled",
        "succeeded",
        "failed",
        "rejected",
        "expired",
        "unknown_outcome"
      ]
    },
    "checkpointRef": {
      "type": "string",
      "minLength": 1
    },
    "pendingEffectId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "policyVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "required": [
    "invocationId",
    "revision",
    "state",
    "policyVersion"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/execution.schema.json",
  "title": "execution"
}
