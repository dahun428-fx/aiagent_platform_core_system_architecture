{
  "type": "object",
  "properties": {
    "content": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "enum": [
        "external",
        "self-hosted"
      ]
    },
    "routeDecisionId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,63}$"
    },
    "usage": {
      "type": "object",
      "properties": {
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "inputTokens",
        "outputTokens"
      ],
      "additionalProperties": false
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-(?!0{32})[0-9a-f]{32}-(?!0{16})[0-9a-f]{16}-[0-9a-f]{2}$"
    }
  },
  "required": [
    "content",
    "provider",
    "routeDecisionId",
    "usage",
    "traceparent"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.example.invalid/contracts/model-result.schema.json",
  "title": "model-result"
}
