    {
      "id": "tool-replay-after-restart",
      "title": "재시작 후 같은 키",
      "slice": "S5",
      "request": {
        "target": "tool-route",
        "toolId": "tool-search",
        "version": "0.1.0",
        "arguments": {
          "query": "hello"
        },
        "idempotencyKey": "scenario-tool-replay-after-restart"
      },
      "steps": [
        {
          "expect": {
            "status": 200,
            "outputContent": "tool:hello",
            "upstreamCalls": {
              "fake-tool": 1
            },
            "auditFields": {
              "tool-route": {
                "outcome": "executed"
              }
            }
          }
        },
        {
          "restart": "tool-route",
          "expect": {
            "status": 200,
            "outputContent": "tool:hello",
            "upstreamCalls": {
              "fake-tool": 0
            },
            "auditFields": {
              "tool-route": {
                "outcome": "replayed"
              }
            }
          }
        }
      ]
    },
