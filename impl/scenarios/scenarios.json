            "model-gateway"
          ]
        },
        "auditFields": {
          "model-route": {
            "classification": "internal"
          }
        }
      }
    },
    {
      "id": "unsigned",
      "title": "서명 없는 내부 호출",
      "slice": "S1",
      "request": {
        "target": "model-route",
        "sign": false
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "FORBIDDEN",
          "detail": "Internal signature missing or invalid"
        },
        "upstreamCalls": {
          "fake-model": 0
        },
        "auditComponents": {
          "model-route": []
        }
      }
    },
    {
      "id": "tampered",
      "title": "서명 후 분류 변조",
      "slice": "S1",
      "request": {
        "target": "model-route",
        "policy": {
          "classification": "confidential",
          "allowedResources": [
            "model-external"
          ]
        },
        "afterSigning": {
          "policy": {
            "classification": "public"
          }
        }
      },
      "expect": {
        "status": 403,
        "body": {
          "code": "FORBIDDEN",
          "detail": "Internal signature missing or invalid"
        },
        "upstreamCalls": {
          "fake-model": 0
        },
        "auditComponents": {
          "model-route": []
        }
      }
    },
