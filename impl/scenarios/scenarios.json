            "dataClassification": "internal"
          },
          "execution": {
            "mode": "sync",
            "timeoutMs": 5000
          }
        }
      },
      "steps": [
        {
          "fault": {
            "fake-model": {
              "status": 500
            }
          },
          "repeat": 3,
          "expect": {
            "status": 502,
            "body": {
              "code": "UPSTREAM_ERROR"
            },
            "upstreamCalls": {
              "fake-model": 9
            }
          }
        },
        {
          "expect": {
            "status": 503,
            "elapsedMs": [
              0,
              100
            ],
            "body": {
              "code": "UPSTREAM_UNAVAILABLE"
            },
            "headers": {
              "Retry-After": "1"
            },
            "upstreamCalls": {
              "fake-model": 0
            },
            "auditComponents": {
              "platform-api": [
                "agent-gateway",
                "runtime"
